NEXT_PUBLIC_VIVAMAR_API_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3003

# URL pública de produção do site (usada em sitemap, robots, canonical e Open Graph).
# Defina o domínio real ao publicar — sem isso, os links de SEO ficam relativos/incompletos.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Access Token do Mercado Pago (secreto — pegue em Suas integrações > Credenciais
# de produção no painel do Mercado Pago do cliente, com a conta REAL dele, não
# uma conta de teste). Nunca prefixar com NEXT_PUBLIC_, é usado só no servidor
# para criar pagamentos e consultar o status de um pagamento.
MERCADOPAGO_ACCESS_TOKEN=

# Chave pública do Mercado Pago (mesma tela de Credenciais de produção). Essa
# pode sim ser exposta no navegador — é o que inicializa o Payment Brick
# (formulário de cartão + Pix embutido no site) no cliente.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# OBRIGATÓRIA em produção (Suas integrações > Webhooks no painel do Mercado
# Pago > chave secreta), usada para validar a assinatura x-signature das
# notificações. Sem essa variável, o webhook rejeita todas as notificações
# (nenhuma reserva é confirmada automaticamente) — não é mais opcional.
MERCADOPAGO_WEBHOOK_SECRET=